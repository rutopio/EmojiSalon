{
  "name": "emoji-salon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "author": "ChingRu <hello@chingru.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "check": "biome check --write . && pnpm lint && pnpm check-types",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw",
    "ui": "pnpm dlx shadcn@latest",
    "preview": "pnpm run build && vite preview",
    "preview:cf": "pnpm build && wrangler pages dev dist",
    "preprocess": "node preprocess/scripts/build-emoji-data.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/albert-sans": "5.2.8",
    "@fontsource-variable/host-grotesk": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "frimousse": "0.3.0",
    "motion": "12.40.0",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@cloudflare/workers-types": "4.20260621.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-devtools": "0.10.7",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.18",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.103.0"
  }
}
