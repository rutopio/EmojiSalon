{
  "name": "emoji-salon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "check": "biome check --write . && pnpm lint && pnpm check-types",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw",
    "ui": "pnpm dlx shadcn@latest",
    "preview": "pnpm run build && vite preview",
    "preview:cf": "pnpm build && wrangler pages dev dist",
    "preprocess": "node preprocess/scripts/build-emoji-data.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "5.100.9",
    "@tanstack/react-router": "1.169.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "frimousse": "0.3.0",
    "motion": "12.40.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
    "react-aria-components": "1.14.0",
    "react-dom": "19.2.3",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0"
  },
  "pnpm": {
    "overrides": {
      "seroval": ">=1.4.1",
      "ip-address": ">=10.1.1",
      "hono": ">=4.12.21",
      "qs": ">=6.15.2",
      "brace-expansion": ">=5.0.6",
      "ws": ">=8.20.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "4.20260606.1",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query-devtools": "5.100.9",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/router-plugin": "1.167.32",
    "@types/node": "24.10.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "wrangler": "4.98.0"
  }
}
